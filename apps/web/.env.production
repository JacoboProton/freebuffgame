# Clerk redirect URLs - hardcoded to prevent Git Bash on Windows from corrupting
# relative paths (/login) to Windows file paths (C:/Program Files/Git/login) during builds.
# Next.js loads .env.production AFTER process.env, so these override the corrupted system vars.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
