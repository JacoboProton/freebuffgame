# ===========================================
# Environment Variables for Vercel Deployment
# ===========================================
# Copy this file to .env.local and fill in the values
# DO NOT commit .env.local to version control!

# --- Clerk Authentication ---
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Clerk backend secret (for API routes only - keep server-side!)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxx

# --- API URL ---
NEXT_PUBLIC_API_URL=https://freebuffgame-api.onrender.com/api

# --- Push Notifications (Web Push) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# --- Inngest (Background Jobs) ---
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

# --- Database (if using InsForge/Prisma directly) ---
DATABASE_URL=your_database_url